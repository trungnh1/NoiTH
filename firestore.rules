rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /department_patients/{document=**} {
      allow read, write: if true;
    }
    match /clinical_records/{document=**} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
